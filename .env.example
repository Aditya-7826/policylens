# Copy to .env and fill in. Both providers are free (no credit card).

# --- Primary LLM: Groq free tier (https://console.groq.com/keys)
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
# Large model: answers. Small model: extraction, classification, judging.
# Check the current IDs with: uv run python -m scripts.check_models
GROQ_LARGE_MODEL=openai/gpt-oss-120b
GROQ_SMALL_MODEL=openai/gpt-oss-20b

# --- Fallback LLM: NVIDIA NIM (https://build.nvidia.com) - limited trial credits
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_LARGE_MODEL=meta/llama-3.3-70b-instruct
NVIDIA_SMALL_MODEL=meta/llama-3.1-8b-instruct

# --- Daily token budgets per model tier (Groq's free caps are per model; keep a margin below them)
# Check your real caps at https://console.groq.com/settings/limits
GROQ_LARGE_DAILY_TOKENS=600000
GROQ_SMALL_DAILY_TOKENS=1500000
NVIDIA_LARGE_DAILY_TOKENS=50000
NVIDIA_SMALL_DAILY_TOKENS=50000

# --- Local models (run on CPU, no API; loaded once per process)
EMBED_MODEL=BAAI/bge-small-en-v1.5
# Reranker, measured on a CPU laptop for 6 passages:
#   cross-encoder/ms-marco-MiniLM-L-6-v2  +0.5 GB RAM, 0.7 s   (default, fine on 8 GB)
#   BAAI/bge-reranker-base                +1.6 GB RAM, 4.5 s   (use with 16 GB RAM)
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
# Chunks embedded / graph-extracted per batch during ingestion (lower = less RAM)
INGEST_BATCH_SIZE=64

# --- Neo4j Community (docker compose up -d neo4j)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=policylens-dev

# --- Retrieval / answering knobs
RETRIEVE_TOP_K=10
RERANK_TOP_N=6
ABSTAIN_THRESHOLD=0.45

# --- API location used by the Streamlit UI
API_URL=http://localhost:8000

# --- Free tier also caps requests: 1000/day per model (keep a margin)
GROQ_DAILY_REQUESTS=950
NVIDIA_DAILY_REQUESTS=500
# gpt-oss models reason before answering; "low" keeps hidden reasoning tokens small ("" disables)
LLM_REASONING_EFFORT=low
# Per-minute token cap is 8000 per model on the free tier; calls are paced to stay below it
GROQ_TOKENS_PER_MINUTE=7000
